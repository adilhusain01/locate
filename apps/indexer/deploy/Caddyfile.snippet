# Locate indexer (/root/Projects/locate/apps/indexer): ponder start under systemd on 127.0.0.1:42069.
# Ponder sends its own CORS headers, so Caddy only terminates TLS and compresses.
# DNS first: A record locate-indexer.adilhusain.xyz -> 13.140.56.191, AAAA -> 2400:d321:2360:5616::1
locate-indexer.adilhusain.xyz {
	encode zstd gzip
	reverse_proxy 127.0.0.1:42069
}
